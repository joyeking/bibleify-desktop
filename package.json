{
  "name": "Bibleify",
  "version": "1.0.0",
  "description": "Simple Bible Desktop App with Dramatized Audio",
  "main": "main.js",
  "scripts": {
    "eslint": "eslint 'src/**/*.js'",
    "prod": "webpack --config webpack.build.config.js && electron --noDevServer .",
    "dev": "webpack serve --config ./webpack.dev.config.js --hot --host 0.0.0.0",
    "build": "webpack --config webpack.build.config.js",
    "package": "webpack --config webpack.build.config.js",
    "postpackage": "electron-packager ./ --out=./builds --icon=./appicon.icns",
    "dev:electron": "electron ."
  },
  "repository": "https://github.com/sonnylazuardi/bibleify-desktop",
  "keywords": [
    "Electron",
    "Bible",
    "Desktop",
    "Audio",
    "Realm",
    "Clappr",
    "React",
    "Rematch"
  ],
  "author": "sonnylazuardi",
  "license": "MIT",
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@rematch/core": "^0.5.2",
    "bootstrap": "^4.6.2",
    "clappr": "^0.11.3",
    "electron-prompt": "^1.7.0",
    "ionicons": "^3.0.0",
    "rc-slider": "^8.6.13",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-keydown": "^1.9.7",
    "react-redux": "^7.2.9",
    "realm": "^12.13.1",
    "reactstrap": "^8.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.26.5",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "electron": "^28.3.3",
    "electron-packager": "^17.1.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.4",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "sass": "^1.83.4",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  },
  "engines": {
    "node": ">=18 <=20"
  }
}
